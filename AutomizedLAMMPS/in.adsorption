log log.adsorption append
units real
atom_style full
boundary p p p

pair_style lj/cut/coul/long 12.5
kspace_style ewald 1.0e-4
kspace_modify gewald 1.0e-4
pair_modify mix arithmetic

bond_style      harmonic
angle_style     hybrid cosine/periodic fourier
dihedral_style  harmonic
improper_style  fourier

read_data data.MOF5_final extra/atom/types 2 extra/bond/types 2 extra/angle/types 2
molecule gas_mol co2.mol

pair_coeff 6 6 0.05365 2.8
pair_coeff 7 7 0.1569 3.05

group gas type 6:7
variable T equal 298.0
variable p_step index 0.1 0.5 1.0 5.0 10.0 20.0
label loop
    variable P_atm equal v_p_step*0.986923
    reset_timestep 0
    fix myint gas rigid/nvt/small molecule temp ${T} ${T} 100.0
    fix mygcmc gas gcmc 10 500 0 0 92774 ${T} -1.0 1.0 mol gas_mol pressure ${P_atm} fugacity_coeff 1.0 rigid myint
    # fix myint gas rigid/nvt/small molecule temp ${T} ${T} 100.0
    variable n_mols equal count(gas)/3
    thermo_style custom step temp press v_P_atm v_n_mols
    thermo 1000
    run 50
    fix avg all ave/time 10 100 1000 v_n_mols file adsorption.txt mode scalar append
    run 5000
    unfix mygcmc
    unfix myint
    unfix avg
    next p_step
jump SELF loop