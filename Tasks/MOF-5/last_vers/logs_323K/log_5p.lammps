  scanning impropers ...
  3 = max impropers/atom
  triclinic box = (0 0 0) to (26.029363 26.031584 26.028346) with tilt (0.003152 -0.002169 0.002663)
  2 by 5 by 2 MPI processor grid
  reading bonds ...
  512 bonds
  reading angles ...
  912 angles
  reading dihedrals ...
  960 dihedrals
  reading impropers ...
  576 impropers
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     4 = max # of 1-2 neighbors
    12 = max # of 1-3 neighbors
    24 = max # of 1-4 neighbors
    22 = max # of special neighbors
  special bonds CPU = 0.003 seconds
  read_data CPU = 0.026 seconds

# --- Определение параметров для CO2 ---
# Массы для новых типов атомов (6: C_CO2, 7: O_CO2)
mass            6 12.011   # C in CO2
mass            7 15.9994  # O in CO2

# Pair Coeffs для CO2 (MOF-5 pair_coeffs читаются из data-файла)
# pair_coeff I J epsilon sigma
pair_coeff      6 6 0.0514 2.85    # C_CO2 - C_CO2
pair_coeff      7 7 0.1600 3.02    # O_CO2 - O_CO2

# Правила смешивания для межмолекулярных взаимодействий (например, MOF-CO2)
# Lorentz-Berthelot по умолчанию для lj/cut/coul/long
pair_modify     mix arithmetic

# Bond Coeffs для CO2 (тип связи 7)
# bond_coeff Type K r0
bond_coeff      7 1000.0 1.16   # C=O

# Angle Coeffs для CO2 (тип угла 10)
# angle_coeff Type K theta0 (для стиля harmonic)
angle_coeff     10 harmonic 100.0 180.0 # O=C=O

# --- Настройки дальнодействующих взаимодействий ---
kspace_style    pppm 1.0e-5

# --- Определение молекулы CO2 ---
molecule        co2mol CO2.txt
Read molecule template co2mol:
# CO2 molecule template for LAMMPS
  1 molecules
  0 fragments
  3 atoms with max type 7
  2 bonds with max type 7
  1 angles with max type 10
  0 dihedrals with max type 0
  0 impropers with max type 0

# --- Настройки GCMC ---
variable        T equal 323.0       # Температура в Кельвинах
variable        P equal 0.1         # Давление в атмосферах
variable        fug_coeff equal 1.0 # Коэффициент фугитивности (для идеального газа = 1.0)
variable        seed equal 12345    # Начальное число для генератора случайных чисел

# Группа для атомов CO2 (типы 6 и 7)
group           co2_atoms type 6 7
0 atoms in group co2_atoms


# Variables for analysis
variable N_co2  equal count(co2_atoms)/3
variable ads_density equal v_N_co2/vol

dump            dall all atom 100 dumps_T323K/dump_npt_${press}.lammpstrj
dump            dall all atom 100 dumps_T323K/dump_npt_5.lammpstrj

fix             mynpt all nvt temp 323.0 323.0 100.0

# Thermo output
thermo          100
thermo_style    custom step temp press vol density etotal
run             10000
