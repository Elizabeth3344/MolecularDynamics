unfix           mynpt


# Fix GCMC
# N: выполнять GCMC каждые N шагов
# Nexchange: количество попыток обмена (вставка/удаление)
# Ntranslate_rotate_mol: количество попыток трансляции/вращения молекулы
# Nrigidbody_... : 0, так как CO2 у нас гибкий
# mol co2mol: используемый шаблон молекулы
# full_energy: пересчитывать полную энергию системы (рекомендуется)
# pressure ${P}: давление (LAMMPS вычислит химический потенциал)
# displace: максимальное смещение для трансляции молекулы (в Ангстремах)
#fix             gcmc_run all gcmc 100 100 100 0 ${seed} ${T} ${P} ${fug_coeff} mol co2mol full_energy displace 0.5
fix             GCMC co2_atoms gcmc 100 1000 0 0 12345 273.0 -5.0 0.5 mol co2mol pressure ${press} full_energy group co2_atoms
fix             GCMC co2_atoms gcmc 100 1000 0 0 12345 273.0 -5.0 0.5 mol co2mol pressure 2 full_energy group co2_atoms

# --- Настройки вывода ---
#thermo_style    custom step temp press pe etotal natoms ncmc_insert ncmc_delete ncmc_trans ncmc_rotate ncmc_attempt ncmc_accept atoms_in_gcmc_mol


thermo          1000
thermo_style    custom step temp press v_N_co2 v_ads_density pe ke etotal
dump            gcmc_dump all atom 500 dumps_T273K/dump.gcmc_mof5_co2_${press}.lammpstrj
dump            gcmc_dump all atom 500 dumps_T273K/dump.gcmc_mof5_co2_2.lammpstrj

# --- Запуск симуляции ---
# Для GCMC обычно не нужен MD integrator для всей системы, если только не изучается динамика каркаса.
# Если каркас должен быть подвижен, добавьте fix nvt для атомов MOF-5.
# Например, если атомы MOF-5 должны оставаться фиксированными:
# group mof_atoms type <= 5
# fix freeze_mof mof_atoms setforce 0.0 0.0 0.0
# Однако, для GCMC лучше, чтобы каркас был термостатирован, если он не абсолютно жесткий.
# Если вы хотите просто провести GCMC без MD шагов для каркаса:
# run 0 post no # Это позволит fix gcmc работать без MD шагов
# Но обычно GCMC совмещают с MD:
timestep        1.0 # фемтосекунды (если есть MD)
run             100000 # Количество шагов GCMC/MD
