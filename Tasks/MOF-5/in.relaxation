#NVT релаксация и оптимизация геометрии

# 1. Инициализация
units           real
atom_style      full
boundary        p p p
pair_style lj/cut/coul/cut 12.0 12.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic

# 2. Чтение данных MOF-5
read_data       /home/chernysheva/MolecularDynamics/Tasks/MOF-5/MOF5.data

# 3. Выбор силового поля
# Силовое поле UFF
pair_style lj/cut/coul/cut 12.0 12.0
pair_coeff      * * 0.0 0.0  # Обнуляем все взаимодействия
include          ../../MolecularDynamics/Tasks/MOF-5/UFF.mof5     # Файл с параметрами UFF для MOF-5

# Силовое поле DREIDING
pair_style lj/cut/coul/cut 12.0 12.0
# pair_coeff      * * 0.0 0.0
# include         DREIDING.mof5  # Файл с параметрами DREIDING для MOF-5

# Параметры связей
bond_coeff 1 500.0 2.0    # Zn-O
bond_coeff 2 400.0 1.4    # C-C
bond_coeff 3 600.0 1.2    # C=O
bond_coeff 4 340.0 1.1    # C-H

# 4. NVT релаксация
reset_timestep  0
thermo          100
thermo_style    custom step temp pe ke etotal press vol
velocity        all create 300.0 4928459 rot yes dist gaussian

fix             nvt all nvt temp 300.0 300.0 100.0
timestep        1.0
run             5000
unfix           nvt

# 5. Оптимизация геометрии (минимизация энергии)
reset_timestep  0
thermo          10
thermo_style    custom step pe etotal evdwl ecoul epair emol elong

min_style       cg
minimize        1.0e-6 1.0e-8 1000 10000

# 6. Сохранение результатов
write_data      /home/chernysheva/MolecularDynamics/Tasks/MOF-5/MOF-5_optimized.data
