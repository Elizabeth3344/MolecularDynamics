units           real
atom_style      full
boundary        p p p

bond_style morse
bond_style harmonic
angle_style harmonic
angle_style cosine
angle_style cosine/periodic
dihedral_style charmm
improper_style umbrella
pair_style buck
pair_style buck/coul/cut
pair_style buck/coul/long
pair_style lj/cut
pair_style lj/cut/coul/cut
pair_style lj/cut/coul/long
pair_style hbond/dreiding/lj
pair_style hbond/dreiding/morse
special_bonds dreiding

read_data MOF5.data

fix nvt all nvt temp 300.0 300.0 100.0 # NVT термостат Ланжевена
thermo_style custom step temp press etotal pe ke # сами задаем параметры термодинамики, которые хотим вывести
thermo 1000 # вывод каждые 1000 шагов

dump         1 all custom 100 snaps/traj.lammpstrj id type x y z vx vy vz

run 10000 # Запуск NVT релаксации на 10000 шагов


