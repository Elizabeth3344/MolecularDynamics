# LAMMPS script for CO2 adsorption in MOF-5 at 298K and 0.1 bar
log             log.adsorption_0.1bar append
units           real
atom_style      full
boundary        p p p

# Force field with electrostatics
pair_style      lj/cut/coul/long 12.500
bond_style      harmonic
angle_style     hybrid cosine/periodic fourier
dihedral_style  harmonic
improper_style  fourier

dielectric      1.0
pair_modify     tail yes mix arithmetic
special_bonds   lj/coul 0.0 0.0 1.0

# Load optimized MOF-5 structure
# read_data       C0.data
read_data mofff.data 

# Define CO2 molecule
molecule co2_mol CO2.txt

kspace_style    pppm 1.0e-6

# UFF параметры для основных типов (это пример ,надо будет найти правильные)
pair_coeff 1 1 0.060 3.118  # O  (ε=0.060, σ=3.118)
pair_coeff 2 2 0.124 2.462  # Zn (ε=0.124, σ=2.462)
pair_coeff 3 3 0.060 3.118  # O  (карбоксилат)
pair_coeff 4 4 0.105 3.431  # C  (карбоксилат)
pair_coeff 5 5 0.105 3.431  # C  (бензол)
pair_coeff 6 6 0.105 3.431  # C  (бензол)
pair_coeff 7 7 0.020 2.571  # H  (бензол)
pair_coeff 8 8 0.105 3.431  # C  (CO₂)
pair_coeff 9 9 0.060 3.118  # O  (CO₂)

bond_coeff      1 5000.0 1.16   # CO2 C=O bond (harmonic)

# Atom groupings
group           mof type 1:7   # Adjust based on your atom types
group           co2 type 8:9   # CO2 atom types

# check atoms in groups
variable N_mof equal count(mof)
print "Number of MOF atoms: group ${N_mof}"

# Variables for analysis
variable N_co2  equal count(co2)/3
variable ads_density equal v_N_co2/vol

# Equilibration run
fix             nvt all nvt temp 298.0 298.0 100.0
timestep        1.0
run             5000
unfix           nvt

# Reset for GCMC
reset_timestep  0

# GCMC for adsorption at 0.1 bar
fix GCMC co2 gcmc 100 1000 0 0 12345 298.0 -5.0 0.5 mol co2_mol pressure 0.1 full_energy group co2

# Output and data collection
thermo          1000
thermo_style    custom step temp press v_N_co2 v_ads_density pe ke etotal
fix AVE all ave/time 100 100 10000 v_N_co2 file co2_adsorption_0.1bar.txt

# Equilibration phase
run             500000

# Reset for production
reset_timestep  0

# Production phase with data collection
dump            1 all atom 10000 dump.adsorption_0.1bar.lammpstrj
run             1000000

# Save final state
write_data      MOF-5_with_co2_0.1bar.data