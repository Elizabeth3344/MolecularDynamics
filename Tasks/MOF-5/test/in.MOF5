units           real
atom_style      full
boundary        p p p

pair_style      lj/cut 12.500
bond_style      harmonic
angle_style     hybrid fourier cosine/periodic
dihedral_style  harmonic
improper_style  fourier

pair_modify     tail yes mix arithmetic
special_bonds   lj/coul 0.0 0.0 1.0
dielectric      1.0
box tilt        large
read_data       data.MOF5

molecule co2_mol CO2.txt

#### Atom Groupings ####
# group           fram     id   1:424
#### END Atom Groupings ####

dump dall all atom 100 dump_all.lammpstrj

# Настройка термостата и баростата
fix             mynpt all npt temp 323.0 323.0 100.0 iso 1.0 1.0 1000.0

# Термодинамические параметры
thermo          100
thermo_style    custom step temp press vol density etotal

# Минимизация энергии перед релаксацией
min_style       cg
minimize        1.0e-6 1.0e-8 1000 10000

# Релаксация в NPT ансамбле
run             10000
unfix           mynpt

# Запись релаксированной системы в файл
write_data      data.MOF5_relaxed

