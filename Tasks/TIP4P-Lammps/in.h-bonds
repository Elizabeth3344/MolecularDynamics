# # Анализ водородных связей в системе воды TIP4P

# # Инициализация
# units real
# atom_style full
# boundary p p p

# pair_style lj/cut/tip4p/long 1 2 1 1 0.1546 12
# kspace_style pppm/tip4p 1.0e-4

# bond_style harmonic
# angle_style harmonic

# # Загрузка последней конфигурации
# read_data tip4p-NPT.data

# # Восстановление силового поля (как в предыдущих расчетах)
# pair_coeff      1 1 0.18521 3.1589 # O-O
# pair_coeff      2 2 0.0    0.0     # H-H
# pair_coeff      1 2 0.0    0.0     # O-H
# pair_modify     tail yes

# bond_coeff      1 1000.0 0.9572    # O-H
# angle_coeff     1 100.0 104.52     # H-O-H

# # Группировка атомов
# group gH2O type 1 2
# group oxygen type 1
# group hydrogen type 2

# # Параметры анализа H-связей
# variable max_OO_dist equal 3.5    # максимальное расстояние O-O
# variable min_angle equal 150      # минимальный угол O-H...O

# # 1. Создание соседних списков для анализа
# compute nbO oxygen neigh/atom cut ${max_OO_dist}
# compute nbH hydrogen neigh/atom cut 2.5

# # 2. Запись траектории с дополнительной информацией
# dump 1 all custom 100 traj_hbond.lammpstrj id type x y z c_nbO[*] c_nbH[*]
# dump_modify 1 element O H H

# # 3. Фиксация геометрии молекул
# fix shake gH2O shake 1.0e-4 100 0 b 1 a 1

# # Запуск анализа в NVT ансамбле
# fix nvt all nvt temp 300.0 300.0 100.0
# thermo 100
# run 10000

# print "Анализ завершен. Данные для расчета H-связей сохранены в traj_hbond.lammpstrj"
# print "Для точного анализа используйте Python-скрипт постобработки"
